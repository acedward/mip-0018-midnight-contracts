// SPDX-License-Identifier: Apache-2.0
//
// A native shielded token with one static domain separator that describes
// itself on chain per MIP-0018 (MIP PR #325,
// `mips/mip-0018-on-chain-token-metadata.md` @ `37a3471`) on the UC-1 layout
// (2-byte `val-len`; see ./TokenMetadata.compact and ../TOKEN-METADATA.md).
//
// Composition:
//   OpenZeppelin `NativeShieldedToken`  the domain, the colour, the mint, and
//                                       the MIP-0011 name()/symbol()/decimals()
//   `TokenMetadata`                     the events, and who may emit them
//                                       (the emitter secret, spec 00024 Q12)
//
// ONE DECLARATION PER CALL (UC-1). The only emitting circuit is `setMetadata`,
// and it emits exactly one declaration, so the deployer publishes `name`,
// `symbol` and `decimals` as three calls — three intents, three packages.
// Every value it can carry fits one event (at most 188 bytes); a longer value
// is a multi-part package, which the literal contracts in ./generated/ emit.
//
// Minting is deliberately NOT gated: these are reference test tokens and an
// open mint keeps the mint circuit (already k=14) from also paying for a proof.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/token/NativeShieldedToken" prefix Token_;

export { ContractAddress, Either, Maybe, ShieldedCoinInfo, ZswapCoinPublicKey, TM_emitterSecretHash };

constructor(
  emitterSecretHash: Bytes<32>,
  domain_: Bytes<32>,
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>
) {
  TM_initializeEmitter(emitterSecretHash);
  Token_initialize(domain_, name_, symbol_, decimals_);
}

/** The token's colour: `tokenType(domainSep, this contract)`. */
export circuit tokenColor(): Bytes<32> {
  return Token_tokenColor();
}

/** The domain separator this contract mints under. */
export circuit domainSep(): Bytes<32> {
  return Token__domain;
}

export circuit name(): Opaque<"string"> {
  return Token_name();
}

export circuit symbol(): Opaque<"string"> {
  return Token_symbol();
}

export circuit decimals(): Uint<8> {
  return Token_decimals();
}

/**
 * @description Declares one metadata key (EIP-7496's dynamic trait update) as a
 * one-part package. Emitter only. Last write wins for the consumer.
 */
export circuit setMetadata(key: Bytes<32>, valType: Uint<8>, valLen: Uint<16>, value: Bytes<188>): [] {
  TM_assertEmitter();
  TM_emitTokenMetadata(
    Token__domain,
    TM_KIND_SHIELDED(),
    disclose(key),
    disclose(valType),
    disclose(valLen),
    disclose(value)
  );
}

/**
 * @description Mints `amount` of this token to `recipient`, a Zswap coin public key.
 * OpenZeppelin 0.4.0-alpha.3 (#833) mints only to a `ZswapCoinPublicKey` (a contract
 * recipient is limited to the contract itself, `_mintToSelf`), so this takes the key
 * directly rather than an `Either`.
 * @param {Bytes<32>} nonce - Caller-supplied and unique per mint.
 */
export circuit mint(
  recipient: ZswapCoinPublicKey,
  amount: Uint<64>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  return Token__mint(disclose(recipient), disclose(amount), disclose(nonce));
}
