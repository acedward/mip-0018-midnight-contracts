// SPDX-License-Identifier: Apache-2.0
//
// One contract, many tokens: a collection whose pieces each get their own
// domain separator — and therefore their own colour — at one address. This is
// the ERC-1155 / EIP-7496 shape the standard is modelled on, and the case a
// token indexer has to get right: five rows sharing an address, distinguished
// only by `domainSep`.
//
// Composition:
//   OpenZeppelin `NativeShieldedTokenFamily`  colour and mint, per domain
//   `TokenMetadata`                           the events, and who may emit them
//                                             (the emitter secret, spec 00024 Q12)
//
// ONE DECLARATION PER CALL (UC-1): `setPieceTrait` is the only emitting circuit.
// A piece's name, the family symbol and decimals, its `tokenUri` and every trait
// are separate calls; re-declaring a key IS the update path (last write wins).

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/token/NativeShieldedTokenFamily" prefix Family_;

export { ContractAddress, Either, Maybe, ShieldedCoinInfo, ZswapCoinPublicKey, TM_emitterSecretHash };

/** How many pieces have been minted, for a cheap read-back after deployment. */
export ledger _mintedPieces: Counter;

constructor(
  emitterSecretHash: Bytes<32>,
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>
) {
  TM_initializeEmitter(emitterSecretHash);
  Family_initialize(name_, symbol_, decimals_);
}

/** The colour of one piece: `tokenType(pieceDomain, this contract)`. */
export circuit tokenColor(pieceDomain: Bytes<32>): Bytes<32> {
  return Family_tokenColor(disclose(pieceDomain));
}

export circuit name(): Opaque<"string"> {
  return Family_name();
}

export circuit symbol(): Opaque<"string"> {
  return Family_symbol();
}

export circuit decimals(): Uint<8> {
  return Family_decimals();
}

export circuit mintedPieces(): Uint<64> {
  return _mintedPieces.read() as Uint<64>;
}

/**
 * @description Mints one unit of the piece identified by `pieceDomain`.
 * @param {Bytes<32>} nonce - Caller-supplied, unique per (piece, mint).
 */
export circuit mintPiece(
  pieceDomain: Bytes<32>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  _mintedPieces.increment(1);
  return Family__mint(disclose(pieceDomain), disclose(recipient), 1, disclose(nonce));
}

/** Declares one key of one piece (EIP-7496 dynamic trait) as a one-part package. Emitter only. */
export circuit setPieceTrait(
  pieceDomain: Bytes<32>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<16>,
  value: Bytes<188>
): [] {
  TM_assertEmitter();
  TM_emitTokenMetadata(disclose(pieceDomain), TM_KIND_SHIELDED(), disclose(key),
                       disclose(valType), disclose(valLen), disclose(value));
}
