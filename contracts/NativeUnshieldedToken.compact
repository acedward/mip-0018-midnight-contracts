// SPDX-License-Identifier: Apache-2.0
//
// A native UNSHIELDED token with one static domain separator that describes
// itself on chain per MIP-0018 (MIP PR #325,
// `mips/mip-0018-on-chain-token-metadata.md` @ `37a3471`) on the UC-1 layout
// (2-byte `val-len`; see ./TokenMetadata.compact and ../TOKEN-METADATA.md).
//
// OpenZeppelin has no unshielded counterpart to `NativeShieldedToken`, so the
// minimal body is inlined here: `mintUnshieldedToken` from the Compact standard
// library, the same shape `effectstream/mint-test-tokens` v2 uses. Who may emit
// is the `TokenMetadata` module's emitter secret (spec 00024 Q12).
//
// The `kind_` constructor argument exists so the reference deployment can also
// describe its LEDGER side (`kind = 2`) while minting natively (kind 0) — the
// "Ledger Liar" row of the reference set. Under MIP section 4 the full kind
// byte is part of the token identity, so that is not a contradiction: it is two
// rows, an OBSERVED kind-0 row with no name and a DECLARED kind-2 row with one
// (MIP sections 6.3 and 7.2). Honest deployments pass `TM_KIND_UNSHIELDED()` (0).
//
// ONE DECLARATION PER CALL (UC-1): `setMetadata` is the only emitting circuit.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;

export { ContractAddress, Either, Maybe, UserAddress, TM_emitterSecretHash };

/** Domain separator fixed at construction; with the address it is the colour. */
export sealed ledger _domain: Bytes<32>;
/** The kind byte published by this contract (0 for an honest deployment). */
export sealed ledger _kind: Uint<8>;
export sealed ledger _decimals: Uint<8>;

constructor(
  emitterSecretHash: Bytes<32>,
  domain_: Bytes<32>,
  decimals_: Uint<8>,
  kind_: Uint<8>
) {
  TM_initializeEmitter(emitterSecretHash);
  _domain = disclose(domain_);
  _decimals = disclose(decimals_);
  _kind = disclose(kind_);
}

/** The token's colour: `tokenType(domainSep, this contract)`. */
export circuit tokenColor(): Bytes<32> {
  return tokenType(_domain, kernel.self());
}

export circuit domainSep(): Bytes<32> {
  return _domain;
}

export circuit decimals(): Uint<8> {
  return _decimals;
}

/** The kind byte this contract declares (see MIP section 3). */
export circuit kind(): Uint<8> {
  return _kind;
}

/** Declares one metadata key (EIP-7496 dynamic trait) as a one-part package. Emitter only. */
export circuit setMetadata(key: Bytes<32>, valType: Uint<8>, valLen: Uint<16>, value: Bytes<188>): [] {
  TM_assertEmitter();
  TM_emitTokenMetadata(_domain, _kind, disclose(key), disclose(valType), disclose(valLen), disclose(value));
}

/**
 * @description Mints `amount` of this token to `recipient` as an unshielded
 * UTxO. Unshielded outputs are public by construction, so `recipient` is
 * necessarily revealed on chain.
 * @return {Bytes<32>} - The colour actually minted.
 */
export circuit mint(
  recipient: Either<ContractAddress, UserAddress>,
  amount: Uint<64>
): Bytes<32> {
  assert(amount > 0, "amount must be positive");
  assert(
    recipient.is_left
      ? !(default<ContractAddress> == recipient.left)
      : !(default<UserAddress> == recipient.right),
    "invalid recipient"
  );
  return mintUnshieldedToken(_domain, disclose(amount), disclose(recipient));
}
