// SPDX-License-Identifier: Apache-2.0
//
// MetadataProbe — the compile-and-byte-layout proof for the MIP's payload on
// the UC-1 layout. It is not a token: it exists so a test can call the module
// directly and assert that `Bytes[...spread]` really produces the 256 bytes of
// a one-part package at the documented offsets (domainSep 0, kind 32, key 33,
// val-type 65, val-len 66..67 little-endian, value 68..255).
//
// It is also the source of the negative corpus: every field is a parameter, so
// the probe can emit payloads a conforming consumer MUST reject (a reserved
// val-type, a val-len beyond the package, an empty key, an unknown kind byte, a
// JSON fragment, a Null with a non-zero val-len, a `/metadata/` key that is not
// an RFC 6901 pointer) and the events a consumer MUST ignore rather than
// reject — a `Misc` event under the pre-MIP name `TokenMetadata`, and one under
// the `mip-xxxx:token-metadata[v1]` placeholder name the Stagenet reference set
// was deployed with (MIP section 1: any other name MUST be ignored). Those two
// keep the one-byte `val-len` layout their emitters used.
//
// NO EMITTER CHECK, on purpose: this harness must emit arbitrary, deliberately
// invalid payloads for tests and is never deployed. Every other emitting
// circuit in this repository checks the emitter secret (TokenMetadata.compact).

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "../TokenMetadata" prefix TM_;

/** Number of `publish*` calls made, so the probe has some state to read back. */
export ledger _calls: Counter;

/**
 * @description Emits one arbitrary TokenMetadata event (the head of a package,
 * `TM_emitHead`). Everything is a parameter so a test can drive every field,
 * including deliberately invalid ones (a `valLen` beyond the package, a reserved
 * `valType`, an unknown `kind`) for the indexer's negative fixtures.
 */
export circuit publishRaw(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<16>,
  value: Bytes<188>
): [] {
  _calls.increment(1);
  TM_emitHead(disclose(domainSep), disclose(kind), disclose(key),
              disclose(valType), disclose(valLen), disclose(value));
}

/**
 * @description Emits one fixed, literal one-part declaration — the golden
 * fixture the byte-exact test is recorded from.
 */
export circuit publishFixture(): [] {
  _calls.increment(1);
  TM_emitTokenMetadata(pad(32, "umbra:probe"), TM_KIND_SHIELDED(), pad(32, "name"),
                       TM_VAL_TYPE_STRING(), 11, pad(188, "Umbra Probe"));
}

/**
 * @description Emits a well-formed payload under the PRE-MIP event name
 * `TokenMetadata` (what this repository's 00020 contracts emitted), in the
 * one-byte `val-len` layout of its time. A MIP consumer must IGNORE it — not
 * store it, not reject it — because the name is not
 * `mip-0018:token-metadata[v1]` (MIP section 1). The name is written here
 * rather than taken from the module on purpose: the module has exactly one
 * event name and it is the current one.
 */
export circuit publishLegacyName(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<8>,
  value: Bytes<189>
): [] {
  _calls.increment(1);
  emit(Misc {
    name: pad(32, "TokenMetadata"),
    payload: Bytes[...disclose(domainSep), disclose(kind), ...disclose(key),
                   disclose(valType), disclose(valLen), ...disclose(value)]
  });
}

/**
 * @description Emits a payload under `mip-xxxx:token-metadata[v1]`, the
 * PLACEHOLDER name of the #315 draft, which is the name this repository's
 * Stagenet reference set was actually deployed with (commit `1721636`, blocks
 * 508 432 – 508 599), in that draft's one-byte `val-len` layout. The event name
 * is the layout version (MIP section 8), so a conforming MIP-0018 consumer
 * IGNORES these too — a consumer that also wants to display the legacy
 * deployment must recognise the second name explicitly and validate it under
 * the draft's rules. This circuit exists so that case is real compiled-contract
 * output in the corpus rather than a hand-built payload.
 */
export circuit publishPreMipName(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<8>,
  value: Bytes<189>
): [] {
  _calls.increment(1);
  emit(Misc {
    name: pad(32, "mip-xxxx:token-metadata[v1]"),
    payload: Bytes[...disclose(domainSep), disclose(kind), ...disclose(key),
                   disclose(valType), disclose(valLen), ...disclose(value)]
  });
}

/** The number of publish calls seen so far. */
export circuit calls(): Uint<64> {
  return _calls.read() as Uint<64>;
}
