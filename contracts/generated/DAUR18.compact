/** Mints the shielded half of this token (kind byte 1). */
export circuit mintShielded(
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  amount: Uint<64>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
