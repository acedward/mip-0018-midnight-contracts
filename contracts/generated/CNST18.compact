export circuit publishAltairRepository(): [] {
  TM_assertEmitter();
  // altair: repository = "https://github.com/acedward/mip-0018-midnight-contracts/blob/main/contracts/generated/CNST18.compact" (val-type 4 URI, val-len 100)
  TM_emitTokenMetadata(pad(32, "cnst18:altair"), 1, pad(32, "repository"), 4, 100, pad(188, "https://github.com/acedward/mip-0018-midnight-contracts/blob/main/contracts/generated/CNST18.compact"));
}

/**
 * @description setPieceTrait — one declaration, one TokenMetadata event, every byte a compile-time literal. Emitter only.
 */
export circuit publishAltairTokenUri(): [] {
  TM_assertEmitter();
  // altair: tokenUri = "http://localhost:10020/constellations/altair" (val-type 4 URI, val-len 44)
  TM_emitTokenMetadata(pad(32, "cnst18:altair"), 1, pad(32, "tokenUri"), 4, 44, pad(188, "http://localhost:10020/constellations/altair"));
}

/**
 * @description setPieceTrait — one declaration, one TokenMetadata event, every byte a compile-time literal. Emitter only.
 */
export circuit publishAltairHemisphere(): [] {
  TM_assertEmitter();
  // altair: hemisphere = "equatorial" (val-type 1 string, val-len 10)
  TM_emitTokenMetadata(pad(32, "cnst18:altair"), 1, pad(32, "hemisphere"), 1, 10, pad(188, "equatorial"));
}
