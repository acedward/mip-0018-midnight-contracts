// SPDX-License-Identifier: Apache-2.0
//
// A LEDGER token: balances live in the contract's own state, not in UTxOs.
// Nothing is ever minted at the protocol level, so no colour exists and no
// scanner can ever see this token in a transaction's mint effects. Its
// TokenMetadata events (kind `2` — unshielded ledger) are the ONLY way it can
// appear in a token table at all, which is the half of the standard that a
// native token cannot demonstrate.
//
// Composition:
//   OpenZeppelin `FungibleToken`  balances, allowances, transfer
//   OpenZeppelin `Ownable`        who may mint
//   `TokenMetadata`               the events, and who may emit them
//                                 (the emitter secret, spec 00024 Q12)
//
// ONE DECLARATION PER CALL (UC-1): `setMetadata` is the only emitting circuit,
// so `name`, `symbol` and `decimals` are three calls (see ./TokenMetadata.compact).
//
// The domain separator is an arbitrary 32-byte label this contract picks for
// itself (`pad(32, "umbra:lsun")` in the reference deployment). It identifies
// the token inside the contract exactly as it would for a native token; it just
// never reaches `kernel.mintUnshielded`.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;
import "../node_modules/@openzeppelin/compact-contracts/token/FungibleToken" prefix Token_;

export { ContractAddress, Either, Maybe, TM_emitterSecretHash };

/** The label this contract uses as the token's `domainSep` in its events. */
export sealed ledger _domain: Bytes<32>;

constructor(
  emitterSecretHash: Bytes<32>,
  owner: Either<Bytes<32>, ContractAddress>,
  domain_: Bytes<32>,
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>
) {
  TM_initializeEmitter(emitterSecretHash);
  Ownable_initialize(owner);
  Token_initialize(name_, symbol_, decimals_);
  _domain = disclose(domain_);
}

export circuit domainSep(): Bytes<32> {
  return _domain;
}

export circuit name(): Opaque<"string"> {
  return Token_name();
}

export circuit symbol(): Opaque<"string"> {
  return Token_symbol();
}

export circuit decimals(): Uint<8> {
  return Token_decimals();
}

export circuit totalSupply(): Uint<128> {
  return Token_totalSupply();
}

export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return Token_balanceOf(account);
}

/**
 * @description Declares one metadata key (EIP-7496 dynamic trait) with the
 * LEDGER kind byte (`2` = unshielded ledger) as a one-part package. Emitter only.
 */
export circuit setMetadata(key: Bytes<32>, valType: Uint<8>, valLen: Uint<16>, value: Bytes<188>): [] {
  TM_assertEmitter();
  TM_emitTokenMetadata(_domain, TM_KIND_LEDGER_FLAG(), disclose(key), disclose(valType), disclose(valLen), disclose(value));
}

/**
 * @description Credits `amount` to `account` in contract state. No protocol
 * mint happens, so no transaction effect records this and no colour exists.
 */
export circuit mint(account: Either<Bytes<32>, ContractAddress>, amount: Uint<128>): [] {
  Ownable_assertOnlyOwner();
  Token__mint(disclose(account), disclose(amount));
}

/** Moves `amount` from the caller's balance to `to`. */
export circuit transfer(to: Either<Bytes<32>, ContractAddress>, amount: Uint<128>): Boolean {
  return Token_transfer(disclose(to), disclose(amount));
}

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}
